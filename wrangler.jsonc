{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tougouban48",
  "main": "worker.js",
  "compatibility_date": "2026-07-07",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "Claude用",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "kv_namespaces": [
    {
      "binding": "TEXT_KV",
      "id": "f488d1f76d7e4782a29dfa703b81375b"
    }
  ],
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
