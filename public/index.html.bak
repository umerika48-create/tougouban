ace": "福岡", "memo": "吉武洋美", "addedAt": 1787858849944, "visible": true}];
const INITIAL_DATA_GENERATED_AT = "2026-08-29 16:26";

let friends = INITIAL_DATA.slice();
let editingId = null;
let activeCategory = 'すべて';
let selectedIds = new Set();
let serverSynced = false; // 初回のサーバー同期が終わるまでtrueにならない（保存の事故防止）

function fmtDate(d){
  if(!d) return '未設定';
  const [y,m,dd] = d.split('-');
  return `${y}年${parseInt(m)}月${parseInt(dd)}日`;
}
function fmtTime(t, unknown){
  if(unknown || !t) return '時刻不明';
  return t;
}

function parseDateInput(str){
  if(!str || !str.trim()) return '';
  let cleaned = str.trim();
  if(/^\d{8}$/.test(cleaned)){
    const y = cleaned.slice(0,4), mo = cleaned.slice(4,6), d = cleaned.slice(6,8);
    return `${y}-${mo}-${d}`;
  }
  cleaned = cleaned.replace(/[／．]/g, '/').replace(/[年月]/g, '/').replace(/日/g, '');
  const m = cleaned.match(/(\d{4})\D+(\d{1,2})\D*(\d{1,2})?/);
  if(!m || !m[3]) return null;
  const y = m[1], mo = m[2].padStart(2,'0'), d = m[3].padStart(2,'0');
  return `${y}-${mo}-${d}`;
}

function parseTimeInput(str){
  if(!str || !str.trim()) return '';
  let cleaned = str.trim();
  if(/^\d{1,4}$/.test(cleaned)){
    let h, mi;
    if(cleaned.length <= 2){ h = cleaned; mi = '0'; }
    else if(cleaned.length === 3){ h = cleaned.slice(0,1); mi = cleaned.slice(1); }
    else { h = cleaned.slice(0,2); mi = cleaned.slice(2); }
    h = h.padStart(2,'0'); mi = mi.padStart(2,'0');
    if(parseInt(h) > 23 || parseInt(mi) > 59) return null;
    return `${h}:${mi}`;
  }
  cleaned = cleaned.replace(/：/g, ':').replace(/時/g, ':').replace(/分/g, '');
  const m = cleaned.match(/(\d{1,2})\D*(\d{1,2})?/);
  if(!m) return null;
  const h = m[1].padStart(2,'0');
  const mi = (m[2] || '0').padStart(2,'0');
  if(parseInt(h) > 23 || parseInt(mi) > 59) return null;
  return `${h}:${mi}`;
}

function escapeHtml(s){
  if(!s) return '';
  return String(s).replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
}

/* ============================================================
   サーバーAPIとの通信
   ============================================================ */
function setSyncBanner(text, kind){
  const el = document.getElementById('sync-banner');
  el.textContent = text;
  el.className = kind || '';
}

async function loadFromServer(){
  try{
    const res = await fetch('/api/data', { cache: 'no-store' });
    if(!res.ok) throw new Error('HTTP ' + res.status);
    const data = await res.json();
    if(Array.isArray(data)){
      // サーバーが空配列（まだ何も保存されていない）の場合は、
      // 埋め込み初期データを表示済みのまま保持する（消さない）
      if(data.length > 0){
        friends = data;
      }
      render();
      setSyncBanner('最新データを取得しました', 'ok');
      setTimeout(() => setSyncBanner(''), 2500);
    }
  }catch(e){
    // 取得に失敗しても、表示済みのデータは絶対に消さない・置き換えない
    setSyncBanner('⚠ 最新データの取得に失敗しました（表示中の内容は最新でない可能性があります）', 'err');
  }finally{
    // 成功・失敗にかかわらず、初回同期の試行が終わったことを記録する。
    // これより前は保存操作をブロックし、初期表示データで上書き保存する事故を防ぐ。
    serverSynced = true;
  }
}

async function saveToServer(){
  if(!serverSynced){
    setSyncBanner('⚠ サーバーとの同期が完了するまで、少しお待ちください（保存できませんでした）', 'err');
    return false;
  }
  try{
    const res = await fetch('/api/data', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(friends)
    });
    if(!res.ok) throw new Error('HTTP ' + res.status);
    return true;
  }catch(e){
    setSyncBanner('⚠ 保存に失敗しました（オフラインの可能性があります。もう一度お試しください）', 'err');
    return false;
  }
}

/* ============================================================
   描画
   ============================================================ */
function render(){
  const list = document.getElementById('list');
  const q = document.getElementById('search').value.trim().toLowerCase();
  document.getElementById('count').textContent = friends.length;

  renderCategoryFilter();

  let filtered = friends.filter(f => f.name.toLowerCase().includes(q));
  if(activeCategory !== 'すべて'){
    filtered = filtered.filter(f => (f.category || '未分類') === activeCategory);
  }

  if(filtered.length === 0){
    list.innerHTML = `<div class="empty"><span class="star">＊</span>${friends.length===0 ? 'まだ登録がありません。上のフォームから追加してください。' : '該当する友達が見つかりません。'}</div>`;
    return;
  }

  const groups = {};
  filtered.forEach(f => {
    const cat = f.category || '未分類';
    if(!groups[cat]) groups[cat] = [];
    groups[cat].push(f);
  });

  const catOrder = Object.keys(groups).sort((a,b) => {
    if(a === '本人') return 1;
    if(b === '本人') return -1;
    if(a === '未分類') return 1;
    if(b === '未分類') return -1;
    return a.localeCompare(b, 'ja');
  });

  list.innerHTML = catOrder.map(cat => `
    <div class="group-title" style="display:flex;align-items:center;gap:8px;">
      <span>${escapeHtml(cat)}（${groups[cat].length}）</span>
      <button class="cat-vis-btn" data-cat="${escapeHtml(cat)}" data-vis="true" style="font-size:10px;padding:2px 8px;border-radius:10px;border:1px solid var(--line);background:transparent;color:var(--ink-dim);cursor:pointer;">全員表示</button>
      <button class="cat-vis-btn" data-cat="${escapeHtml(cat)}" data-vis="false" style="font-size:10px;padding:2px 8px;border-radius:10px;border:1px solid var(--line);background:transparent;color:var(--ink-dim);cursor:pointer;">全員非表示</button>
    </div>
    ${groups[cat].map(f => `
      <div class="entry" data-id="${f.id}" style="${f.visible === false ? 'opacity:.5;' : ''}">
        <input type="checkbox" class="select-check" data-id="${f.id}" ${selectedIds.has(f.id) ? 'checked' : ''} style="width:auto;margin-top:3px;flex-shrink:0;accent-color:var(--gold);">
        <div class="info">
          <div class="name">${escapeHtml(f.name)}${f.visible === false ? ' <span style="font-size:10px;color:var(--rose);">（統合アプリ非表示）</span>' : ''}</div>
          <div class="meta">
            生年月日：${fmtDate(f.date)}<br>
            出生時刻：${fmtTime(f.time, f.timeUnknown)}<br>
            出生地：${escapeHtml(f.place) || '未設定'}
            ${f.memo ? `<br><span style="color:var(--gold-soft);">MEMO：</span>${escapeHtml(f.memo).replace(/\n/g,'<br>')}` : ''}
          </div>
        </div>
        <div class="actions">
          <button class="btn-ghost vis-toggle-btn" data-id="${f.id}">${f.visible === false ? '表示する' : '非表示にする'}</button>
          <button class="btn-ghost edit-btn" data-id="${f.id}">編集</button>
          <button class="btn-ghost del-btn" data-id="${f.id}">削除</button>
        </div>
      </div>
    `).join('')}
  `).join('');

  list.querySelectorAll('.cat-vis-btn').forEach(btn => {
    btn.addEventListener('click', async () => {
      const cat = btn.getAttribute('data-cat');
      const vis = btn.getAttribute('data-vis') === 'true';
      friends.forEach(f => { if((f.category || '未分類') === cat) f.visible = vis; });
      await saveToServer();
      render();
    });
  });

  list.querySelectorAll('.vis-toggle-btn').forEach(btn => {
    btn.addEventListener('click', async () => {
      const id = btn.getAttribute('data-id');
      const f = friends.find(x => x.id === id);
      if(!f) return;
      f.visible = f.visible === false ? true : false;
      await saveToServer();
      render();
    });
  });

  list.querySelectorAll('.select-check').forEach(cb => {
    cb.addEventListener('change', () => {
      const id = cb.getAttribute('data-id');
      if(cb.checked) selectedIds.add(id);
      else selectedIds.delete(id);
      updateSelectionStatus();
    });
  });

  list.querySelectorAll('.edit-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const id = btn.getAttribute('data-id');
      const f = friends.find(x => x.id === id);
      if(!f) return;
      editingId = id;
      document.getElementById('f-name').value = f.name || '';
      document.getElementById('f-date').value = f.date ? f.date.replace(/^(\d{4})-(\d{2})-(\d{2})$/, (_,y,m,d)=>`${y}/${parseInt(m)}/${parseInt(d)}`) : '';
      document.getElementById('f-time').value = f.time || '';
      document.getElementById('f-time-unknown').checked = !!f.timeUnknown;
      document.getElementById('f-category').value = f.category || '未分類';
      document.getElementById('f-place').value = f.place || '';
      document.getElementById('f-memo').value = f.memo || '';
      document.getElementById('add-btn').textContent = '更新する';
      document.getElementById('cancel-edit-btn').style.display = 'inline-block';
      document.getElementById('panel-title').textContent = `編集中：${f.name}`;
      window.scrollTo({top:0, behavior:'smooth'});
    });
  });

  list.querySelectorAll('.del-btn').forEach(btn => {
    btn.addEventListener('click', async () => {
      const id = btn.getAttribute('data-id');
      friends = friends.filter(f => f.id !== id);
      selectedIds.delete(id);
      await saveToServer();
      render();
    });
  });
}

function renderCategoryFilter(){
  const cats = Array.from(new Set(friends.map(f => f.category || '未分類')));
  cats.sort((a,b) => {
    if(a === '本人') return 1;
    if(b === '本人') return -1;
    if(a === '未分類') return 1;
    if(b === '未分類') return -1;
    return a.localeCompare(b, 'ja');
  });

  const filterEl = document.getElementById('cat-filter');
  const all = ['すべて', ...cats];
  if(!all.includes(activeCategory)) activeCategory = 'すべて';

  filterEl.innerHTML = all.map(c =>
    `<button class="chip${c === activeCategory ? ' active' : ''}" data-cat="${escapeHtml(c)}">${escapeHtml(c)}</button>`
  ).join('');
  filterEl.querySelectorAll('.chip').forEach(btn => {
    btn.addEventListener('click', () => {
      activeCategory = btn.getAttribute('data-cat');
      render();
    });
  });

  const exportBar = document.getElementById('cat-export-bar');
  const exportBtn = document.getElementById('export-category-btn');
  if(activeCategory === 'すべて'){
    exportBar.style.display = 'none';
  } else {
    exportBar.style.display = 'block';
    const countInCat = friends.filter(f => (f.category || '未分類') === activeCategory).length;
    exportBtn.textContent = `「${activeCategory}」（${countInCat}人）をJSONで出力`;
  }
}

function updateSelectionStatus(){
  const bar = document.getElementById('selection-bar');
  const countEl = document.getElementById('selection-count');
  if(selectedIds.size === 0){
    bar.style.display = 'none';
    return;
  }
  bar.style.display = 'flex';
  countEl.textContent = `${selectedIds.size}人を選択中`;
}

/* ============================================================
   クリップボードコピー
   ============================================================ */
async function copyExportText(text, label){
  const box = document.getElementById('export-box');
  const statusEl = document.getElementById('export-copy-status');
  box.style.display = 'block';
  box.value = text;
  try{
    await navigator.clipboard.writeText(text);
    statusEl.textContent = `${label}をコピーしました！そのまま貼り付けできます。`;
    box.select();
  }catch(e){
    box.select();
    try{
      document.execCommand('copy');
      statusEl.textContent = `${label}をコピーしました！そのまま貼り付けできます。`;
    }catch(e2){
      statusEl.textContent = `自動コピーできませんでした。上の欄の内容を選択してコピーしてください。`;
    }
  }
  setTimeout(() => { statusEl.textContent=''; }, 4000);
}

/* ============================================================
   フォーム操作
   ============================================================ */
function resetForm(){
  document.getElementById('f-name').value = '';
  document.getElementById('f-date').value = '';
  document.getElementById('f-time').value = '';
  document.getElementById('f-time-unknown').checked = false;
  document.getElementById('f-category').value = '未分類';
  document.getElementById('f-place').value = '';
  document.getElementById('f-memo').value = '';
  editingId = null;
  document.getElementById('add-btn').textContent = '追加する';
  document.getElementById('cancel-edit-btn').style.display = 'none';
  document.getElementById('panel-title').textContent = '新しく追加';
}

document.getElementById('add-btn').addEventListener('click', async () => {
  const name = document.getElementById('f-name').value.trim();
  const dateRaw = document.getElementById('f-date').value;
  const timeRaw = document.getElementById('f-time').value;
  const timeUnknown = document.getElementById('f-time-unknown').checked;
  const category = document.getElementById('f-category').value || '未分類';
  const place = document.getElementById('f-place').value.trim();
  const memo = document.getElementById('f-memo').value.trim();
  const statusEl = document.getElementById('add-status');

  if(!name){
    statusEl.textContent = '名前を入力してください。';
    return;
  }
  const date = parseDateInput(dateRaw);
  if(date === null){
    statusEl.textContent = '生年月日の形式が読み取れません。例）1986/8/8 のように入力してください。';
    return;
  }
  let time = '';
  if(!timeUnknown){
    time = parseTimeInput(timeRaw);
    if(time === null){
      statusEl.textContent = '出生時刻の形式が読み取れません。例）23:59 または 23時59分';
      return;
    }
  }

  if(editingId){
    const idx = friends.findIndex(f => f.id === editingId);
    if(idx !== -1){
      friends[idx] = { ...friends[idx], name, date, time, timeUnknown, category, place, memo };
    }
    await saveToServer();
    render();
    statusEl.textContent = `${name}さんを更新しました。`;
    resetForm();
  } else {
    friends.push({
      id: Date.now().toString(36) + Math.random().toString(36).slice(2,6),
      name, date, time, timeUnknown, category, place, memo,
      addedAt: Date.now(), visible: true
    });
    await saveToServer();
    render();
    statusEl.textContent = `${name}さんを追加しました。`;
    resetForm();
  }
  setTimeout(() => { statusEl.textContent=''; }, 3500);
});

document.getElementById('cancel-edit-btn').addEventListener('click', () => {
  resetForm();
  document.getElementById('add-status').textContent = '';
});

document.getElementById('search').addEventListener('input', render);

/* ============================================================
   出力（コピー）系
   ============================================================ */
document.getElementById('export-json-btn').addEventListener('click', () => {
  copyExportText(JSON.stringify(friends, null, 2), '全員分のJSON');
});

document.getElementById('export-csv-btn').addEventListener('click', () => {
  const header = '名前,カテゴリー,生年月日,出生時刻,出生地,MEMO\n';
  const rows = friends.map(f =>
    `${f.name},${f.category||'未分類'},${f.date||''},${f.timeUnknown ? '不明' : (f.time||'')},${f.place||''},"${(f.memo||'').replace(/"/g,'""')}"`
  ).join('\n');
  copyExportText(header + rows, 'CSV');
});

document.getElementById('export-category-btn').addEventListener('click', () => {
  const inCat = friends.filter(f => (f.category || '未分類') === activeCategory);
  copyExportText(JSON.stringify(inCat, null, 2), `「${activeCategory}」${inCat.length}人分`);
});

document.getElementById('export-selected-btn').addEventListener('click', () => {
  const selected = friends.filter(f => selectedIds.has(f.id));
  copyExportText(JSON.stringify(selected, null, 2), `選択した${selected.length}人分`);
});

document.getElementById('clear-selection-btn').addEventListener('click', () => {
  selectedIds.clear();
  render();
});

/* ============================================================
   他所からのJSON貼り付け統合（任意の補助機能）
   ============================================================ */
document.getElementById('import-toggle-btn').addEventListener('click', () => {
  const panel = document.getElementById('import-panel');
  panel.style.display = panel.style.display === 'none' ? 'block' : 'none';
});

document.getElementById('import-merge-btn').addEventListener('click', async () => {
  const raw = document.getElementById('import-box').value.trim();
  const statusEl = document.getElementById('import-status');
  if(!raw){
    statusEl.textContent = '貼り付ける内容がありません。';
    return;
  }
  let parsed;
  try{
    parsed = JSON.parse(raw);
    if(!Array.isArray(parsed)) throw new Error('not array');
  }catch(e){
    statusEl.textContent = 'JSON形式が正しく読み取れませんでした。';
    return;
  }

  const nameIndex = {};
  friends.forEach((f, i) => { nameIndex[f.name] = i; });
  let added = 0, updated = 0;
  parsed.forEach(f => {
    if(!f || !f.name) return;
    if(nameIndex.hasOwnProperty(f.name)){
      friends[nameIndex[f.name]] = { ...friends[nameIndex[f.name]], ...f };
      updated++;
    } else {
      friends.push({
        id: f.id || (Date.now().toString(36) + Math.random().toString(36).slice(2,6)),
        name: f.name, date: f.date || '', time: f.time || '',
        timeUnknown: !!f.timeUnknown, category: f.category || '未分類',
        place: f.place || '', memo: f.memo || '',
        addedAt: f.addedAt || Date.now(),
        visible: f.visible === undefined ? true : f.visible
      });
      nameIndex[f.name] = friends.length - 1;
      added++;
    }
  });

  await saveToServer();
  render();
  statusEl.textContent = `新規${added}人・更新${updated}人。合計${friends.length}人になりました。`;
  document.getElementById('import-box').value = '';
});

/* ============================================================
   初期化
   ============================================================ */
render();
loadFromServer();
</script>
</body>
</html>
