<!DOCTYPE html>
<html lang="ja">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>友達データ帳</title>
<style>
  @import url('https://fonts.googleapis.com/css2?family=Shippori+Mincho:wght@500;700&family=Noto+Sans+JP:wght@400;500&display=swap');

  :root{
    --night: #171b2e;
    --night-2: #1f2440;
    --card: #232a4a;
    --gold: #c9a876;
    --gold-soft: #e8d9b8;
    --rose: #c98a9e;
    --ink: #f2ede1;
    --ink-dim: #b8b4c4;
    --line: rgba(201,168,118,0.25);
  }
  *{box-sizing:border-box;}
  body{
    margin:0;
    background:
      radial-gradient(circle at 15% 8%, rgba(201,168,118,0.10), transparent 40%),
      radial-gradient(circle at 85% 92%, rgba(201,138,158,0.08), transparent 40%),
      var(--night);
    color:var(--ink);
    font-family:'Noto Sans JP',sans-serif;
    padding:32px 20px 60px;
    min-height:100vh;
  }
  .wrap{max-width:640px;margin:0 auto;}
  header{margin-bottom:20px;text-align:center;}
  header .eyebrow{
    font-size:12px;letter-spacing:.15em;color:var(--gold);
    text-transform:uppercase;margin-bottom:6px;
  }
  header h1{
    font-family:'Shippori Mincho',serif;font-weight:700;
    font-size:28px;margin:0 0 6px;color:var(--gold-soft);
  }
  header p{margin:0;color:var(--ink-dim);font-size:13px;}

  #sync-banner{
    text-align:center;font-size:11px;color:var(--ink-dim);
    margin-bottom:16px;min-height:16px;
  }
  #sync-banner.err{color:var(--rose);}
  #sync-banner.ok{color:#9ad6a0;}

  .panel{
    background:var(--card);
    border:1px solid var(--line);
    border-radius:14px;
    padding:20px 22px;
    margin-bottom:20px;
  }
  .panel h2{
    font-family:'Shippori Mincho',serif;font-size:16px;font-weight:500;
    color:var(--gold-soft);margin:0 0 16px;
    display:flex;align-items:center;gap:8px;flex-wrap:wrap;
  }
  .panel h2 .dot{width:6px;height:6px;border-radius:50%;background:var(--gold);flex-shrink:0;}

  .field{margin-bottom:14px;}
  .field label{
    display:block;font-size:12px;color:var(--ink-dim);margin-bottom:6px;
  }
  .field input, .field select, .field textarea{
    width:100%;padding:10px 12px;border-radius:8px;
    border:1px solid var(--line);background:var(--night-2);
    color:var(--ink);font-size:14px;font-family:inherit;
  }
  .field input:focus, .field select:focus, .field textarea:focus{outline:none;border-color:var(--gold);}
  .field input::placeholder{color:#6b6a7c;}

  .row2{display:grid;grid-template-columns:1fr 1fr;gap:12px;}
  .unknown-toggle{
    display:flex;align-items:center;gap:6px;margin-top:6px;font-size:12px;color:var(--ink-dim);
  }
  .unknown-toggle input{width:auto;padding:0;}

  button{font-family:inherit;cursor:pointer;border:none;}
  .btn-primary{
    width:100%;padding:12px;border-radius:8px;
    background:var(--gold);color:#241d10;font-weight:500;font-size:14px;
    letter-spacing:.02em;
  }
  .btn-primary:hover{background:var(--gold-soft);}
  .btn-ghost{
    background:transparent;border:1px solid var(--line);color:var(--ink-dim);
    padding:6px 12px;border-radius:6px;font-size:12px;
  }
  .btn-ghost:hover{border-color:var(--gold);color:var(--gold-soft);}

  .toolbar{display:flex;gap:8px;margin-bottom:16px;flex-wrap:wrap;}
  .search{
    flex:1;min-width:140px;padding:9px 12px;border-radius:8px;
    border:1px solid var(--line);background:var(--night-2);color:var(--ink);font-size:13px;
  }

  .cat-filter{display:flex;gap:6px;flex-wrap:wrap;margin-bottom:14px;}
  .chip{
    padding:5px 12px;border-radius:20px;font-size:12px;
    border:1px solid var(--line);color:var(--ink-dim);background:transparent;
  }
  .chip.active{background:var(--gold);color:#241d10;border-color:var(--gold);font-weight:500;}
  .chip:hover{border-color:var(--gold);}

  .group-title{
    font-size:12px;letter-spacing:.08em;color:var(--gold);
    margin:18px 0 8px;text-transform:uppercase;
    display:flex;align-items:center;gap:8px;
  }
  .group-title:first-child{margin-top:0;}
  .group-title::after{content:'';flex:1;height:1px;background:var(--line);}

  .entry{
    border:1px solid var(--line);border-radius:10px;
    padding:14px 16px;margin-bottom:10px;
    display:flex;justify-content:space-between;align-items:flex-start;gap:12px;
  }
  .entry .info .name{
    font-family:'Shippori Mincho',serif;font-size:16px;color:var(--gold-soft);margin-bottom:4px;
  }
  .entry .info .meta{font-size:12px;color:var(--ink-dim);line-height:1.8;}
  .entry .actions{display:flex;gap:6px;flex-shrink:0;flex-wrap:wrap;justify-content:flex-end;}

  .empty{text-align:center;padding:30px 10px;color:var(--ink-dim);font-size:13px;}
  .empty .star{color:var(--gold);font-size:22px;display:block;margin-bottom:8px;}

  .status{font-size:12px;color:var(--gold-soft);margin-top:10px;min-height:16px;}
  textarea.export-box{
    width:100%;min-height:120px;background:var(--night-2);border:1px solid var(--line);
    border-radius:8px;color:var(--ink);font-family:monospace;font-size:11px;padding:10px;
    margin-top:10px;resize:vertical;
  }
</style>
</head>
<body>
<div class="wrap">

  <header>
    <div class="eyebrow">さくらこ｜恋愛占いカウンセラー</div>
    <h1>友達データ帳</h1>
    <p>名前・生年月日・出生時刻・出生地を記録。占いアプリへの取り込み用データ</p>
  </header>

  <div id="sync-banner"></div>

  <div class="panel">
    <h2 id="panel-title"><span class="dot"></span>新しく追加</h2>
    <div class="field">
      <label for="f-name">名前</label>
      <input id="f-name" type="text" placeholder="例）田中花子">
    </div>
    <div class="row2">
      <div class="field">
        <label for="f-date">生年月日</label>
        <input id="f-date" type="text" placeholder="例）1986/8/8 や 19860808">
      </div>
      <div class="field">
        <label for="f-time">出生時刻</label>
        <input id="f-time" type="text" placeholder="例）23:59 や 2359 や 23時59分">
        <div class="unknown-toggle">
          <input id="f-time-unknown" type="checkbox">
          <label for="f-time-unknown" style="margin:0;">時刻不明</label>
        </div>
      </div>
    </div>
    <div class="field">
      <label for="f-category">カテゴリー</label>
      <select id="f-category">
        <option value="未分類">未分類</option>
        <option value="本人">本人</option>
        <option value="友達">友達</option>
        <option value="友達（♂）">友達（♂）</option>
        <option value="親しい友人">親しい友人</option>
        <option value="友達の子供">友達の子供</option>
        <option value="身内">身内</option>
        <option value="先生">先生</option>
        <option value="お客様">お客様</option>
        <option value="仕事関係">仕事関係</option>
        <option value="その他">その他</option>
        <option value="有名人">有名人</option>
        <option value="海外">海外</option>
        <option value="先祖">先祖</option>
        <option value="ヒカル界隈">ヒカル界隈</option>
      </select>
    </div>
    <div class="field">
      <label for="f-place">出生地</label>
      <input id="f-place" type="text" placeholder="例）福岡県福岡市">
    </div>
    <div class="field">
      <label for="f-memo">MEMO</label>
      <textarea id="f-memo" placeholder="性格・エピソード・鑑定メモなど自由に" rows="3"></textarea>
    </div>
    <button class="btn-primary" id="add-btn">追加する</button>
    <button class="btn-ghost" id="cancel-edit-btn" style="display:none;width:100%;margin-top:8px;">キャンセル</button>
    <div class="status" id="add-status"></div>
  </div>

  <div class="panel">
    <h2><span class="dot"></span>登録済みリスト（<span id="count">0</span>件）</h2>
    <div class="toolbar">
      <input class="search" id="search" type="text" placeholder="名前で検索">
      <button class="btn-ghost" id="export-json-btn">JSONで出力</button>
      <button class="btn-ghost" id="export-csv-btn">CSVで出力</button>
      <button class="btn-ghost" id="import-toggle-btn">JSONを貼り付けて統合</button>
    </div>
    <div id="export-copy-status" class="status" style="margin-bottom:4px;"></div>
    <textarea class="export-box" id="export-box" style="display:none;"></textarea>
    <div id="import-panel" style="display:none;margin-bottom:16px;">
      <div class="field">
        <label for="import-box">他で出力したJSONをここに貼り付けてください</label>
        <textarea class="export-box" id="import-box" style="display:block;"></textarea>
      </div>
      <button class="btn-ghost" id="import-merge-btn">貼り付けた内容を統合する（名前が一致する人は更新）</button>
      <div class="status" id="import-status"></div>
    </div>
    <div class="cat-filter" id="cat-filter"></div>
    <div id="cat-export-bar" style="display:none;margin-bottom:12px;">
      <button class="btn-ghost" id="export-category-btn"></button>
    </div>
    <div id="selection-bar" style="display:none;align-items:center;gap:8px;margin-bottom:12px;font-size:12px;color:var(--gold-soft);flex-wrap:wrap;">
      <span id="selection-count"></span>
      <button class="btn-ghost" id="export-selected-btn">選択した人だけJSONで出力</button>
      <button class="btn-ghost" id="clear-selection-btn">選択解除</button>
    </div>
    <div id="list"></div>
  </div>

</div>

<script>
/* ============================================================
   初期表示用データ（このファイルを生成した時点のサーバー上の実データ）
   オフラインでもこのデータがすぐ画面に表示される。
   オンラインなら、この直後に /api/data から最新データを取得して上書きする。
   ============================================================ */
const INITIAL_DATA = [{"id": "mrs2ipmlqo38", "name": "うさみくん", "date": "1993-03-28", "time": "", "timeUnknown": true, "place": "", "category": "友達（♂）", "memo": "22時40分まではASC蠍座それ以降はASC射手座\n22時26分以降から太陽が4ハウス太陽が5ハウスは考えにくいから\n22時26分より前は考えにくい\n23時15時以降から月6ハウス\nそれより前だと月7ハウスに該当\n最初は23時30ごろが濃厚だったけど\n今は22時半ごろ濃厚\n\n恐らく23時より前\nうさみくん日支酉でなさそうだから", "addedAt": 0, "visible": true}, {"id": "mrs2ipml0jz1", "name": "きゃん", "date": "1986-05-19", "time": "13:57", "timeUnknown": false, "place": "福岡", "category": "親しい友人", "addedAt": 0, "visible": true}, {"id": "mrs2ipmlxg1c", "name": "やぁちゃん", "date": "1987-03-23", "time": "01:30", "timeUnknown": false, "place": "福岡", "category": "親しい友人", "addedAt": 0, "visible": true}, {"id": "mrs2ipmlkdz1", "name": "あやこ", "date": "1987-01-27", "time": "19:59", "timeUnknown": false, "place": "福島", "category": "親しい友人", "addedAt": 0, "visible": true}, {"id": "mrs2ipmldxak", "name": "あっちゃん", "date": "1986-06-06", "time": "08:21", "timeUnknown": false, "place": "福岡", "category": "親しい友人", "addedAt": 0, "visible": true}, {"id": "mrs2ipml03dr", "name": "りいちゃん", "date": "1997-02-27", "time": "17:41", "timeUnknown": false, "place": "福岡", "category": "親しい友人", "addedAt": 0, "visible": true, "memo": ""}, {"id": "mrslk32zufcf3e", "name": "まゆこりん", "date": "1986-08-08", "time": "23:59", "timeUnknown": false, "place": "福岡", "category": "親しい友人", "addedAt": 0, "visible": true}, {"id": "mrslk32ztr6l68", "name": "そらちゃん", "date": "1986-11-17", "time": "01:44", "timeUnknown": false, "place": "福岡", "category": "親しい友人", "addedAt": 0, "visible": true}, {"id": "mrslk32z630rzo", "name": "まきのっち", "date": "1986-12-15", "time": "23:56", "timeUnknown": false, "place": "宮崎", "category": "親しい友人", "addedAt": 0, "visible": true}, {"id": "mrslk32zuwruvz", "name": "まどかちゃん", "date": "1989-02-07", "time": "16:27", "timeUnknown": false, "place": "福岡", "category": "親しい友人", "addedAt": 0, "visible": true}, {"id": "mrslk32zmvjtjb", "name": "さわちゃん", "date": "1991-12-06", "time": "16:48", "timeUnknown": false, "place": "福岡", "category": "親しい友人", "addedAt": 0, "visible": true}, {"id": "mrslk32z1hfg1s", "name": "牡丹先生", "date": "1980-05-09", "time": "16:00", "timeUnknown": false, "place": "福岡", "category": "先生", "addedAt": 0, "visible": true}, {"id": "mrslk32zpnyxtp", "name": "光架先生", "date": "1986-02-01", "time": "12:58", "timeUnknown": false, "place": "福岡", "category": "先生", "addedAt": 0, "visible": true}, {"id": "mrslk32z4myjtv", "name": "英恵先生", "date": "1968-10-09", "time": "10:00", "timeUnknown": false, "place": "福岡", "category": "先生", "addedAt": 0, "visible": true}, {"id": "mrsmytaxnk5mcx", "name": "みどりさん", "date": "1971-03-21", "time": "", "timeUnknown": true, "place": "", "category": "仕事関係", "addedAt": 0, "visible": true}, {"id": "mrsmytaxw4tsjc", "name": "金山さん", "date": "1974-05-01", "time": "", "timeUnknown": true, "place": "", "category": "仕事関係", "addedAt": 0, "visible": true}, {"id": "mrsmytaxaj9p87", "name": "井上一也", "date": "1957-03-14", "time": "", "timeUnknown": true, "place": "", "category": "身内", "addedAt": 0, "visible": true}, {"id": "mrsmytaxv4fa0r", "name": "井上由香", "date": "1958-11-05", "time": "", "timeUnknown": true, "place": "", "category": "身内", "addedAt": 0, "visible": true}, {"id": "mrsmytax5ofh07", "name": "井上領", "date": "1990-09-08", "time": "16:52", "timeUnknown": false, "place": "福岡", "category": "身内", "addedAt": 0, "visible": true}, {"id": "mrsmytaxsd5jdl", "name": "ひろき君", "date": "1990-09-08", "time": "07:00", "timeUnknown": false, "place": "", "category": "友達（♂）", "addedAt": 0, "visible": true}, {"id": "mrxvwcez2m7j", "name": "井上礼子", "date": "1953-03-18", "time": "16:00", "timeUnknown": false, "place": "福岡", "category": "身内", "memo": "夕方に生まれた（23時より前）", "addedAt": 0, "visible": true}, {"id": "mrxvx1el371o", "name": "井上洋", "date": "1951-04-15", "time": "22:59", "timeUnknown": false, "place": "福岡", "category": "身内", "addedAt": 0, "memo": "23時より前", "visible": true}, {"id": "mry9j1dha8bg", "name": "かおりちゃん", "date": "1985-01-22", "time": "0